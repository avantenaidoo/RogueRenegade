{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window filesystem access",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:allow-open",

    "fs:read-all",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",

    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-create",
    "fs:allow-open"
  ]
}
