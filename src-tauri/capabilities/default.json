{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window filesystem + dialogs",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:allow-open",
    "dialog:allow-save",

    "fs:read-all",
    "fs:write-all",

    "fs:allow-exists",
    "fs:allow-create",
    "fs:allow-open",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
